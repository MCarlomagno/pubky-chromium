import("//build/buildflag_header.gni")
import("//build/config/chrome_build.gni")

pubky_update_ui = (is_linux || is_win || is_mac) && !is_chromeos &&
                  !is_chrome_branded && !is_chrome_for_testing
buildflag_header("buildflags") {
  header = "buildflags.h"
  flags = [ "PUBKY_UPDATE_UI=$pubky_update_ui" ]
}

source_set("record") {
  sources = [
    "record.cc",
    "record.h",
  ]
  public_deps = [
    "//base",
    "//url",
  ]
  deps = [ "//crypto" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "record_unittest.cc" ]
  data = [ "//pubky/update/testdata/linux-x64.json" ]
  deps = [
    ":record",
    ":test_support",
    "//base",
    "//base/test:test_support",
    "//crypto",
    "//testing/gtest",
  ]
}

source_set("test_support") {
  testonly = true
  sources = [ "test_record.h" ]
  public_deps = [
    ":record",
    "//base",
    "//crypto",
  ]
}
