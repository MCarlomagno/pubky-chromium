source_set("pubky_update") {
  sources = [
    "controller.cc",
    "controller.h",
  ]
  public_deps = [
    "//base",
    "//chrome/common/pubky_update:buildflags",
    "//chrome/common/pubky_update:record",
    "//services/network/public/cpp",
  ]
  deps = [
    "//components/prefs",
    "//net",
  ]
  if (is_mac) {
    sources += [
      "mac_adapter.h",
      "mac_adapter.mm",
      "mac_feed_policy.cc",
      "mac_feed_policy.h",
    ]
    deps += [ "//third_party/sparkle:sparkle" ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [ "controller_unittest.cc" ]
  deps = [
    ":pubky_update",
    "//base",
    "//base/test:test_support",
    "//chrome/common/pubky_update:record",
    "//chrome/common/pubky_update:test_support",
    "//components/prefs:test_support",
    "//crypto",
    "//net",
    "//services/network:test_support",
    "//testing/gtest",
  ]
  if (is_mac) {
    sources += [ "mac_feed_policy_unittest.cc" ]
  }
}
